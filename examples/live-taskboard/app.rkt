#lang racket/base
(require loom loom/html loom/live loom/live-http loom/live-registry loom/live-bus loom/live-notify
         loom/session loom/session-http loom/security loom/db loom/csrf
         racket/file racket/runtime-path racket/string web-server/http)
(define-runtime-path runtime "../../loom/assets/live.mjs")
(define-runtime-path notify "../../loom/assets/live-notify.mjs")
(define-runtime-path boot "boot.mjs")
(define (make-board connect)
  (define sessions (make-session-store))
  (define registry (make-live-registry))
  (define bus (make-live-bus))
  (define topic "shared-tasks")
  (with-db connect (lambda (c)
    (query-exec c "CREATE TABLE IF NOT EXISTS tasks (id TEXT PRIMARY KEY, title TEXT NOT NULL, done INTEGER NOT NULL CHECK(done IN (0,1)))")))
  (define (mutate action)
    (with-db connect (lambda (c) (with-transaction c action)))
    (live-publish! bus topic)
    #f)
  (define (task-row row)
    (define id (vector-ref row 0))
    (element 'li #:attrs (list (list 'data-live-key id))
      (element 'span (vector-ref row 1))
      (element 'span (if (zero? (vector-ref row 2)) "Open" "Done"))
      (element 'button #:attrs (list '(type "button") '(data-live-event "toggle") (list 'data-live-payload id)) "Toggle")
      (element 'button #:attrs (list '(type "button") '(data-live-event "delete") (list 'data-live-payload id)) "Delete")))
  ;; The DB is authoritative. A committed DB effect is not rolled back if
  ;; rendering subsequently fails. Never automatically replay events.
  (define component
    (make-live-component #:initial (lambda () #f)
      #:render (lambda (_)
        (element 'section
          (apply element 'ul (with-db connect (lambda (c)
            (map task-row (query-rows c "SELECT id,title,done FROM tasks ORDER BY id LIMIT 100")))))))
      #:events
      (hash "add" (lambda (s title)
                     (unless (and (string? title) (<= 1 (string-length (string-trim title)) 200))
                       (error 'add "invalid title"))
                     (mutate (lambda (c)
                       (when (>= (query-value c "SELECT COUNT(*) FROM tasks") 100)
                         (error 'add "board full"))
                       (query-exec c "INSERT INTO tasks VALUES (?,?,0)" (csrf-token) (string-trim title)))))
            "toggle" (lambda (s id)
                       (unless (string? id) (error 'toggle "invalid id"))
                       (mutate (lambda (c) (query-exec c "UPDATE tasks SET done=1-done WHERE id=?" id))))
            "delete" (lambda (s id)
                       (unless (string? id) (error 'delete "invalid id"))
                       (mutate (lambda (c) (query-exec c "DELETE FROM tasks WHERE id=?" id)))))))
  (define (asset path)
    (lambda (req) (response/full 200 #f (current-seconds) #"text/javascript; charset=utf-8"
      (list (header #"Cache-Control" #"no-store")) (list (file->bytes path)))))
  (define (home req)
    (define old (web-session-ref sessions req #:secure? #f))
    (define-values (state cookie)
      (if old (values old #f)
          (let-values ([(id state cookie) (start-web-session sessions 'guest #:secure? #f)])
            (values state cookie))))
    (define owner (web-session-csrf state))
    (define id (registry-mount! registry owner component))
    (define result (registry-snapshot registry owner id))
    (define resp (html-response
      `(html ((lang "en"))
        (head (meta ((charset "utf-8"))) (title "Loom Live Taskboard")
              (script ((type "module") (src "/boot.mjs")) ""))
        (body (h1 "Live Taskboard")
              (label ((for "title")) "New task")
              (input ((id "title") (maxlength "200")))
              (button ((id "add") (type "button")) "Add")
              (div ((id "live") (data-id ,id) (data-csrf ,owner) (data-version "0"))
                   ,(live-result-view result))
              (p ((id "error") (role "status")) "")))))
    (struct-copy response resp [headers
      (append (response-headers resp) (list (header #"Cache-Control" #"no-store"))
              (if cookie (list cookie) '()))]))
  (make-app
    (list (route #"GET" "/" home)
          (route #"GET" "/live.mjs" (asset runtime))
          (route #"GET" "/live-notify.mjs" (asset notify))
          (route #"GET" "/boot.mjs" (asset boot))
          (route #"POST" "/live" (make-live-event-handler sessions registry #:secure? #f))
          (route #"POST" "/snapshot" (make-live-snapshot-handler sessions registry #:secure? #f))
          (route #"POST" "/notify"
            (make-live-notification-handler sessions bus
              (lambda (state id) (and (registry-snapshot registry (web-session-csrf state) id) topic))
              #:secure? #f #:timeout 2)))
    #:middleware (list security-headers)))
(module+ main
  (define db (or (getenv "LOOM_LIVE_BOARD_DB") (make-temporary-file "loom-live-board-~a.db")))
  (serve (make-board (lambda () (open-sqlite db)))
         #:port (string->number (or (getenv "LOOM_LIVE_BOARD_PORT") "8080"))))
