#lang racket/base
(require racket/list racket/string "main.rkt" "model.rkt" "http.rkt" web-server/http net/url)
(provide api-operation make-api-app openapi-document current-api-query api-result api-result?)
(define current-api-query (make-parameter (hasheq)))
(struct operation (method path id summary input output status handler query responses) #:transparent)
(struct api-result (status body) #:transparent)
(define methods '(#"GET" #"POST" #"PUT" #"PATCH" #"DELETE" #"HEAD" #"OPTIONS"))
(define (api-operation method path id handler #:summary [summary ""]
                       #:input [input #f] #:output [output #f] #:status [status 200] #:query [query #f] #:responses [responses (hasheq)])
  (unless (and (member method methods) (string? path)
               (regexp-match? #px"^/(?:[A-Za-z0-9._~-]+|:[A-Za-z_][A-Za-z0-9_-]*)(?:/(?:[A-Za-z0-9._~-]+|:[A-Za-z_][A-Za-z0-9_-]*))*$|^/$" path)
               (string? id) (regexp-match? #rx"^[A-Za-z_][A-Za-z0-9_-]*$" id)
               (string? summary) (or (not input) (model? input))
               (or (not output) (model? output))
               (or (not query) (and (model? query)
                 (andmap (lambda (f) (regexp-match? #rx"^[A-Za-z_][A-Za-z0-9_-]*$" (symbol->string (field-name f)))) (model-fields query))))
               (memv status '(200 201 202 204))
               (hash? responses)
               (for/and ([(code schema) (in-hash responses)])
                 (and (exact-integer? code) (<= 400 code 499) (not (= code 400))
                      (model? schema)))
               (or (not output) (not (= status 204)))
               (or (not input) (member method '(#"POST" #"PUT" #"PATCH")))
               (procedure? handler) (procedure-arity-includes? handler 2))
    (error 'api-operation "invalid operation contract"))
  (define params (path-parameters path))
  (unless (= (length params) (length (remove-duplicates params)))
    (error 'api-operation "duplicate path parameter"))
  (operation method path id summary input output status handler query
             (for/hasheq ([(code schema) (in-hash responses)]) (values code schema))))
(define (path-parameters path)
  (for/list ([part (in-list (string-split path "/"))] #:when (string-prefix? part ":"))
    (substring part 1)))
(define (openapi-path path)
  (regexp-replace* #px":([A-Za-z_][A-Za-z0-9_-]*)" path "{\\1}"))
(define (json-content schema)
  (hasheq 'application/json (hasheq 'schema schema)))
(define (validate-operations operations)
  (unless (and (list? operations) (andmap operation? operations))
    (error 'openapi-document "expected operations"))
  (define ids (map operation-id operations))
  (unless (= (length ids) (length (remove-duplicates ids)))
    (error 'openapi-document "duplicate operation ID"))
  ;; Reject equivalent templates using different parameter names across methods.
  (define templates (make-hash))
  (for ([op (in-list operations)])
    (define path (operation-path op))
    (define shape (regexp-replace* #px":[A-Za-z_][A-Za-z0-9_-]*" path ":"))
    (define previous (hash-ref templates shape path))
    (unless (equal? previous path) (error 'openapi-document "inconsistent path parameter names"))
    (hash-set! templates shape path))
  (void))
;; A declared query model is strict: no unknown or repeated keys.
(define (parse-query req schema)
  (if (not schema) (hasheq)
      (let/ec reject
        (define fields (model-fields schema))
        (define pairs (url-query (request-uri req)))
        (when (> (length pairs) 128) (reject #f))
        (define parsed
          (for/fold ([out (hasheq)]) ([p (in-list pairs)])
            (define name (car p))
            (define raw (cdr p))
            (define f (findf (lambda (f) (eq? name (field-name f))) fields))
            (unless (and f (string? raw) (<= (string-length raw) 4096)
                         (not (hash-has-key? out name))) (reject #f))
            (define v
              (case (field-type f)
                [(string) raw]
                [(boolean) (cond [(equal? raw "true") #t] [(equal? raw "false") #f] [else (reject #f)])]
                [(integer) (if (regexp-match? #px"^-?(?:0|[1-9][0-9]*)$" raw)
                               (string->number raw) (reject #f))]
                [(number) (if (regexp-match? #px"^-?(?:0|[1-9][0-9]*)(?:[.][0-9]+)?(?:[eE][+-]?[0-9]+)?$" raw)
                              (string->number raw) (reject #f))]
                [else (reject #f)]))
            (hash-set out name v)))
        (if (null? (validate-model schema parsed)) parsed #f))))
(define (operation-document op)
  (define response-schema
    (cond [(operation-output op)
           (hasheq 'description "Success" 'content (json-content (model-schema (operation-output op))))]
          [(= (operation-status op) 204) (hasheq 'description "No content")]
          [else (hasheq 'description "Success" 'content (json-content (hasheq)))]))
  (define base
    (hasheq 'operationId (operation-id op) 'summary (operation-summary op)
            'parameters (append
                          (for/list ([name (in-list (path-parameters (operation-path op)))])
                            (hasheq 'name name 'in "path" 'required #t 'schema (hasheq 'type "string")))
                          (if (operation-query op)
                            (for/list ([f (in-list (model-fields (operation-query op)))])
                              (hasheq 'name (symbol->string (field-name f)) 'in "query"
                                'required (field-required? f)
                                'schema (hasheq 'type (symbol->string (field-type f)))))
                            '()))
            'responses (for/fold ([out (hasheq (string->symbol (number->string (operation-status op))) response-schema
                               '|400| (hasheq 'description "Invalid input")
                               '|500| (hasheq 'description "Internal error"))])
                         ([(code schema) (in-hash (operation-responses op))])
                         (hash-set out (string->symbol (number->string code))
                           (hasheq 'description "Application error" 'content (json-content (model-schema schema)))))))
  (if (operation-input op)
      (hash-set base 'requestBody (hasheq 'required #t 'content (json-content (model-schema (operation-input op)))))
      base))
(define (openapi-document operations #:title [title "Loom API"] #:version [version "0.1.0"])
  (validate-operations operations)
  (unless (and (string? title) (string? version) (not (equal? title "")) (not (equal? version "")))
    (error 'openapi-document "title and version required"))
  (define paths
    (for/fold ([paths (hasheq)]) ([op (in-list operations)])
      (define key (string->symbol (openapi-path (operation-path op))))
      (define method (string->symbol (string-downcase (bytes->string/utf-8 (operation-method op)))))
      (define entries (hash-ref paths key (hasheq)))
      (when (hash-has-key? entries method) (error 'openapi-document "duplicate operation"))
      (hash-set paths key (hash-set entries method (operation-document op)))))
  (hasheq 'openapi "3.1.0" 'info (hasheq 'title title 'version version) 'paths paths))
(define (operation-route op)
  (route (operation-method op) (operation-path op)
         (lambda (req)
           (define input (operation-input op))
           (define query (parse-query req (operation-query op)))
           (define data (if input
                            (with-handlers ([exn:fail? (lambda (_) #f)])
                              (request-json req))
                            (hasheq)))
           (cond
             [(not query) (json-response (hasheq 'error "invalid-query") #:code 400)]
             [(not (hash? data)) (json-response (hasheq 'error "invalid-json") #:code 400)]
             [(and input (pair? (validate-model input data)))
              (json-response (hasheq 'error "invalid-input" 'details (validate-model input data)) #:code 400)]
             [else
              (define result (parameterize ([current-api-query query]) ((operation-handler op) req data)))
              (cond
                [(api-result? result)
                 (define code (api-result-status result))
                 (define body (api-result-body result))
                 (define schema (hash-ref (operation-responses op) code #f))
                 (if (and schema (hash? body) (null? (validate-model schema body)))
                     (json-response body #:code code)
                     (json-response (hasheq 'error "invalid-response") #:code 500))]
                [(and (operation-output op)
                      (not (and (hash? result) (null? (validate-model (operation-output op) result)))))
                 (json-response (hasheq 'error "invalid-response") #:code 500)]
                [(= (operation-status op) 204)
                 (response/full 204 #f (current-seconds) #f '() '())]
                [else (json-response result #:code (operation-status op))])]))))
(define (make-api-app operations #:title [title "Loom API"] #:version [version "0.1.0"]
                      #:middleware [middleware '()])
  (define document (openapi-document operations #:title title #:version version))
  (make-app (cons (route #"GET" "/openapi.json" (lambda (_) (json-response document)))
                  (map operation-route operations))
            #:middleware middleware))
(module+ test
  (require rackunit net/url racket/promise racket/port json web-server/http)
  (define-model input [title string #t])
  (define-model output [title string #t] [id string #t])
  (define op (api-operation #"POST" "/tasks/:id" "createTask"
               (lambda (req data) (hash-set data 'id (route-param "id")))
               #:input input #:output output #:status 201))
  (define doc (openapi-document (list op)))
  (define spec (hash-ref (hash-ref (hash-ref doc 'paths) '|/tasks/{id}|) 'post))
  (check-equal? (hash-ref spec 'operationId) "createTask")
  (check-equal? (hash-ref (car (hash-ref spec 'parameters)) 'name) "id")
  (check-true (hash-has-key? (hash-ref spec 'responses) '|201|))
  (check-exn exn:fail? (lambda () (openapi-document (list op op))))
  (define app (make-api-app (list op)))
  (define (req method path data)
    (request method (string->url path) (list (header #"Content-Type" #"application/json"))
             (delay '()) (jsexpr->bytes data) "localhost" 8080 "127.0.0.1"))
  (check-equal? (response-code (app (req #"GET" "/openapi.json" #f))) 200)
  (check-equal? (response-code (app (req #"POST" "/tasks/42" (hasheq 'title "task")))) 201)
  (check-equal? (response-code (app (req #"POST" "/tasks/42" (hasheq)))) 400)
  (check-equal? (response-code (app (req #"POST" "/tasks/42" (hasheq 'title "task" 'extra #t)))) 400)
  (define-model filters [limit integer #t] [active boolean #f] [weight number #f])
  (define query-op (api-operation #"GET" "/search" "search"
    (lambda (_ data) (current-api-query)) #:query filters))
  (define query-app (make-api-app (list query-op)))
  (define good (query-app (req #"GET" "/search?limit=20&active=false&weight=1.5" #f)))
  (check-equal? (response-code good) 200)
  (define (body resp)
    (define out (open-output-bytes))
    ((response-output resp) out)
    (bytes->jsexpr (get-output-bytes out)))
  (check-equal? (body good) (hasheq 'limit 20 'active #f 'weight 1.5))
  (check-equal? (body (query-app (req #"GET" "/search?limit=0" #f))) (hasheq 'limit 0))
  (define query-spec (hash-ref (hash-ref (hash-ref (openapi-document (list query-op)) 'paths) '|/search|) 'get))
  (check-equal? (hash-ref query-spec 'parameters)
    (list (hasheq 'name "limit" 'in "query" 'required #t 'schema (hasheq 'type "integer"))
          (hasheq 'name "active" 'in "query" 'required #f 'schema (hasheq 'type "boolean"))
          (hasheq 'name "weight" 'in "query" 'required #f 'schema (hasheq 'type "number"))))
  (check-equal? (response-code (query-app (req #"GET" "/search?limit" #f))) 400)
  (check-equal? (response-code (query-app (req #"GET" (string-append "/search?limit=" (make-string 4097 #\1)) #f))) 400)
  (for ([path '("/search" "/search?limit=abc" "/search?limit=1&limit=2" "/search?limit=1&extra=x" "/search?limit=1&active=yes" "/search?limit=1&weight=+inf.0")])
    (check-equal? (response-code (query-app (req #"GET" path #f))) 400))
  (check-equal? (hash-count (current-api-query)) 0)
  (define-model problem [error string #t])
  (define response-op (api-operation #"GET" "/item/:id" "getItem"
    (lambda (_ data)
      (case (string->symbol (route-param "id"))
        [(missing) (api-result 404 (hasheq 'error "missing"))]
        [(conflict) (api-result 409 (hasheq 'error "conflict"))]
        [(undeclared) (api-result 403 (hasheq 'error "denied"))]
        [(invalid) (api-result 404 (hasheq 'error 42))]
        [else (hasheq 'title "item" 'id "1")]))
    #:output output #:responses (hasheq 404 problem 409 problem)))
  (define response-app (make-api-app (list response-op)))
  (define response-spec (hash-ref (hash-ref (hash-ref
    (openapi-document (list response-op)) 'paths) '|/item/{id}|) 'get))
  (check-equal? (hash-ref (hash-ref (hash-ref response-spec 'responses) '|404|)
    'content) (json-content (model-schema problem)))
  (check-equal? (response-code (response-app (req #"GET" "/item/1" #f))) 200)
  (define missing (response-app (req #"GET" "/item/missing" #f)))
  (check-equal? (response-code missing) 404)
  (check-equal? (body missing) (hasheq 'error "missing"))
  (check-equal? (response-code (response-app (req #"GET" "/item/conflict" #f))) 409)
  (check-equal? (response-code (response-app (req #"GET" "/item/undeclared" #f))) 500)
  (check-equal? (response-code (response-app (req #"GET" "/item/invalid" #f))) 500)
  (check-exn exn:fail? (lambda () (api-operation #"GET" "/x" "x" (lambda (_ d) d)
    #:responses (hasheq 400 problem))))
  (define bad (make-api-app (list (api-operation #"GET" "/bad" "bad" (lambda (_ data) (hasheq)) #:output output))))
  (check-equal? (response-code (bad (req #"GET" "/bad" #f))) 500)
  (define empty (make-api-app (list (api-operation #"DELETE" "/tasks/:id" "deleteTask"
                                     (lambda (_ data) (void)) #:status 204))))
  (check-equal? (response-code (empty (req #"DELETE" "/tasks/42" #f))) 204)
  (check-exn exn:fail? (lambda () (api-operation #"GET" "/:id/:id" "duplicate"
                                   (lambda (_ data) #t))))
  (check-exn exn:fail? (lambda () (openapi-document
    (list op (api-operation #"GET" "/tasks/:other" "getTask" (lambda (_ data) #t))))))
  (check-exn exn:fail? (lambda () (make-api-app
    (list (api-operation #"GET" "/openapi.json" "reserved" (lambda (_ data) #t)))))))
