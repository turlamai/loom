#lang racket/base
(require db racket/list)
(provide migration migration? migrate! applied-migrations)
;; Explicit, append-only migration ledger. Run from a single deployment process.
(struct migration (version description up) #:transparent)
(define (validate-plan plan)
  (unless (and (list? plan)
               (andmap (lambda (m)
                         (and (migration? m)
                              (exact-positive-integer? (migration-version m))
                              (string? (migration-description m))
                              (not (equal? "" (migration-description m)))
                              (procedure? (migration-up m))
                              (procedure-arity-includes? (migration-up m) 1))) plan))
    (error 'migrate! "invalid migration plan"))
  (unless (equal? (map migration-version plan) (range 1 (add1 (length plan))))
    (error 'migrate! "versions must be consecutive and ordered from 1")))
(define (ensure-ledger! conn)
  (query-exec conn "CREATE TABLE IF NOT EXISTS loom_schema_migrations (version INTEGER PRIMARY KEY, description TEXT NOT NULL)"))
(define (read-ledger conn)
  (query-rows conn "SELECT version, description FROM loom_schema_migrations ORDER BY version"))
(define (applied-migrations conn)
  (ensure-ledger! conn)
  (read-ledger conn))
(define (migrate! conn plan)
  (validate-plan plan)
  (call-with-transaction conn
    (lambda ()
      (ensure-ledger! conn)
      (define recorded (read-ledger conn))
      (define expected (map (lambda (m) (vector (migration-version m) (migration-description m))) plan))
      (unless (and (<= (length recorded) (length expected))
                   (equal? recorded (take expected (length recorded))))
        (error 'migrate! "migration history differs from plan"))
      (for/list ([m (in-list (drop plan (length recorded)))])
        ((migration-up m) conn)
        (if (eq? (dbsystem-name (connection-dbsystem conn)) 'postgresql)
            (query-exec conn "INSERT INTO loom_schema_migrations (version, description) VALUES ($1, $2)" (migration-version m) (migration-description m))
            (query-exec conn "INSERT INTO loom_schema_migrations (version, description) VALUES (?, ?)" (migration-version m) (migration-description m)))
        (migration-version m)))))
(module+ test
  (require rackunit "db.rkt")
  (with-db (lambda () (open-sqlite 'memory))
    (lambda (c)
      (define first (migration 1 "tasks" (lambda (tx)
        (query-exec tx "CREATE TABLE tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL)"))))
      (define second (migration 2 "seed" (lambda (tx)
        (query-exec tx "INSERT INTO tasks (title) VALUES (?)" "hello"))))
      (define plan (list first second))
      (check-equal? (migrate! c plan) '(1 2))
      (check-equal? (migrate! c plan) '())
      (check-equal? (query-value c "SELECT count(*) FROM tasks") 1)
      (check-exn exn:fail? (lambda () (migrate! c (list first))))
      (check-exn exn:fail? (lambda () (migrate! c (list first (migration 2 "changed" void)))))
      (check-exn exn:fail? (lambda () (migrate! c (append plan (list
        (migration 3 "failure" (lambda (tx)
          (query-exec tx "INSERT INTO tasks (title) VALUES (?)" "rollback")
          (error 'test "abort"))))))))
      (check-equal? (query-value c "SELECT count(*) FROM tasks") 1)
      (check-equal? (length (applied-migrations c)) 2)
      (check-exn exn:fail? (lambda () (migrate! c (list second)))))))
