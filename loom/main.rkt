#lang racket/base
(require racket/list racket/string net/url web-server/http web-server/servlet-env)
(provide route route? make-app html-response serve route-param current-route-params resolve-route)
(struct route (method path handler) #:transparent)
(define current-route-params (make-parameter (hash)))
(define (route-param name [default #f]) (hash-ref (current-route-params) name (lambda () default)))
(define (html-response tree) (response/xexpr tree))
(define (segments path)
  (if (string=? path "/") '() (string-split (substring path 1) "/" #:trim? #f #:repeat? #f)))
(define (parameter? s) (string-prefix? s ":"))
(define (pattern-key r)
  (cons (route-method r) (map (lambda (s) (if (parameter? s) #f s)) (segments (route-path r)))))
(define (validate-route r)
  (unless (and (route? r) (bytes? (route-method r))
               (regexp-match? #rx#"^[A-Z]+$" (route-method r))
               (string? (route-path r)) (string-prefix? (route-path r) "/")
               (procedure? (route-handler r)) (procedure-arity-includes? (route-handler r) 1))
    (raise-argument-error 'make-app "valid route" r))
  (define names (filter parameter? (segments (route-path r))))
  (unless (and (andmap (lambda (s) (regexp-match? #rx"^:[A-Za-z_][A-Za-z0-9_-]*$" s)) names)
               (= (length names) (length (remove-duplicates names))))
    (error 'make-app "invalid or repeated route parameter")))
(define (match-path pattern actual)
  (and (= (length pattern) (length actual))
       (for/fold ([params (hash)]) ([p (in-list pattern)] [a (in-list actual)])
         (and params (cond [(parameter? p) (and (not (string=? a "")) (hash-set params (substring p 1) a))]
                           [(string=? p a) params] [else #f])))))
(define (specificity r) (count (lambda (s) (not (parameter? s))) (segments (route-path r))))
;; Returns matching route and immutable parameters, plus allowed methods for the path.
(define (resolve-route routes method actual)
  (define matches
    (filter-map (lambda (r) (define params (match-path (segments (route-path r)) actual))
                  (and params (cons r params))) routes))
  (define ordered (sort matches > #:key (lambda (m) (specificity (car m)))))
  (define best (and (pair? ordered) (specificity (caar ordered))))
  (define candidates (if best (filter (lambda (m) (= (specificity (car m)) best)) ordered) '()))
  (define chosen (findf (lambda (m) (bytes=? method (route-method (car m)))) candidates))
  (values (and chosen (car chosen)) (if chosen (cdr chosen) (hash))
          (remove-duplicates (map (lambda (m) (route-method (car m))) candidates))))
(define (make-app routes #:middleware [middleware '()])
  (for-each validate-route routes)
  (define keys (map pattern-key routes))
  (unless (= (length keys) (length (remove-duplicates keys)))
    (error 'make-app "duplicate or ambiguous route"))
  (define (dispatch req)
    (define raw (map path/param-path (url-path (request-uri req))))
    (define actual (if (equal? raw '("")) '() raw))
    (define-values (found params allowed) (resolve-route routes (request-method req) actual))
    (cond [found (parameterize ([current-route-params params]) ((route-handler found) req))]
          [(pair? allowed) (response/xexpr '(html (body (h1 "Method not allowed"))) #:code 405
                                          #:headers (list (header #"Allow" (apply bytes-append (add-between allowed #", ")))))]
          [else (response/xexpr '(html (body (h1 "Not found"))) #:code 404)]))
  (foldr (lambda (wrap next) (wrap next)) dispatch middleware))
(define (serve app #:port [port 8080])
  (serve/servlet app #:port port #:listen-ip "127.0.0.1" #:launch-browser? #f #:servlet-path "/" #:servlet-regexp #rx"" #:command-line? #t))
(module+ test
  (require rackunit)
  (define handler (lambda (req) (html-response '(p "Hello"))))
  (define routes (list (route #"GET" "/users/:id" handler) (route #"GET" "/users/new" handler)))
  (check-exn exn:fail? (lambda () (make-app (list (route #"GET" "/:a" handler) (route #"GET" "/:b" handler)))))
  (check-exn exn:fail? (lambda () (make-app (list (route #"GET" "/:a/:a" handler)))))
  (define-values (r p a) (resolve-route routes #"GET" '("users" "42")))
  (check-equal? (hash-ref p "id") "42")
  (check-equal? (route-path r) "/users/:id")
  (define-values (r2 p2 a2) (resolve-route routes #"GET" '("users" "new")))
  (check-equal? (route-path r2) "/users/new")
  (define-values (r3 p3 a3) (resolve-route routes #"POST" '("users" "new")))
  (check-false r3)
  (check-equal? a3 '(#"GET"))
  (check-true (response? (html-response '(p "Hello")))))
