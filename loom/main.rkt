#lang racket/base
(require racket/list racket/string net/url web-server/http web-server/servlet-env)
(provide route route? make-app html-response serve)
(struct route (method path handler) #:transparent)
(define (html-response tree) (response/xexpr tree))
(define (make-app routes)
  (define keys (map (lambda (r) (cons (route-method r) (route-path r))) routes))
  (unless (= (length keys) (length (remove-duplicates keys)))
    (error 'make-app "duplicate route"))
  (lambda (req)
    (define path (string-append "/" (string-join (map path/param-path (url-path (request-uri req))) "/")))
    (define found (findf (lambda (r) (and (bytes=? (route-method r) (request-method req)) (string=? (route-path r) path))) routes))
    (if found ((route-handler found) req) (response/xexpr '(html (body (h1 "Not found"))) #:code 404))))
(define (serve app #:port [port 8080])
  (serve/servlet app #:port port #:listen-ip "127.0.0.1" #:launch-browser? #f #:servlet-path "/" #:servlet-regexp #rx"" #:command-line? #t))
(module+ test
  (require rackunit)
  (check-exn exn:fail? (lambda () (make-app (list (route #"GET" "/" values) (route #"GET" "/" values)))))
  (check-true (response? (html-response '(p "Hello")))))
