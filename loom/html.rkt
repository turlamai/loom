#lang racket/base
(require racket/list racket/string)
(provide element page-layout define-component)
;; Conservative HTML subset. Dynamic content is text, not executable markup.
(define tags '(html head title meta link body main header footer nav section article aside div span p h1 h2 h3 h4 h5 h6 ul ol li dl dt dd a img button form label input textarea select option table caption thead tbody tr th td strong em small code pre blockquote br hr figure figcaption))
(define void-tags '(meta link img input br hr))
(define attrs '(id class title lang dir role name value type method action href src alt width height placeholder for checked disabled selected required autocomplete colspan rowspan scope charset content rel tabindex))
(define (safe-url? s)
  (and (not (regexp-match? #px"[\\x00-\\x20\\x7f]" s))
       (not (string-contains? s "\\"))
       (not (string-prefix? s "//"))
       (or (not (regexp-match? #px"^[A-Za-z][A-Za-z0-9+.-]*:" s))
           (regexp-match? #px"(?i:^https?://)" s))))
(define (safe-attribute? name)
  (or (memq name attrs)
      (regexp-match? #rx"^(aria|data)-[a-z][a-z0-9-]*$" (symbol->string name))))
(define (normalize-attrs pairs)
  (unless (list? pairs) (error 'element "expected attribute list"))
  (define names
    (for/list ([a (in-list pairs)])
      (unless (and (list? a) (= (length a) 2) (symbol? (car a))
                   (safe-attribute? (car a)) (string? (cadr a)))
        (error 'element "unsupported attribute"))
      (when (and (memq (car a) '(href src action)) (not (safe-url? (cadr a))))
        (error 'element "unsafe URL"))
      (car a)))
  (unless (= (length names) (length (remove-duplicates names)))
    (error 'element "duplicate attribute"))
  pairs)
(define (normalize-node node)
  (cond [(string? node) node]
        [(number? node) (number->string node)]
        [(and (list? node) (pair? node) (memq (car node) tags)
              (pair? (cdr node)) (list? (cadr node)))
         (apply element (car node) #:attrs (cadr node) (cddr node))]
        [else (error 'element "unsupported child; use text or an element")]))
(define (element tag #:attrs [attributes '()] . children)
  (unless (memq tag tags) (error 'element "unsupported tag"))
  (when (and (memq tag void-tags) (pair? children))
    (error 'element "void element cannot contain children"))
  (when (and (eq? tag 'title) (not (andmap string? children)))
    (error 'element "title must contain text only"))
  ;; Disallow refresh and stylesheet injection in the constrained builder.
  (when (and (eq? tag 'meta) (assq 'content attributes))
    (error 'element "meta content is not supported"))
  (cons tag (cons (normalize-attrs attributes) (map normalize-node children))))
(define-syntax-rule (define-component (name arg ...) body ...)
  (define (name arg ...) body ...))
(define (page-layout #:title title #:lang [lang "en"] . children)
  (element 'html #:attrs (list (list 'lang lang))
           (element 'head (element 'meta #:attrs '((charset "utf-8"))) (element 'title title))
           (apply element 'body children)))
(module+ test
  (require rackunit)
  (check-equal? (element 'p "<script>alert(1)</script>") '(p () "<script>alert(1)</script>"))
  (check-equal? (element 'a #:attrs '((href "/users")) "Users") '(a ((href "/users")) "Users"))
  (check-exn exn:fail? (lambda () (element 'script "x")))
  (check-exn exn:fail? (lambda () (element 'img #:attrs '((onerror "x")))))
  (check-exn exn:fail? (lambda () (element 'a #:attrs '((href "JaVaScRiPt:alert(1)")))))
  (check-exn exn:fail? (lambda () (element 'a #:attrs '((href "//example.com")))))
  (check-exn exn:fail? (lambda () (element 'div '(script () "x"))))
  (check-exn exn:fail? (lambda () (element 'img "text")))
  (check-exn exn:fail? (lambda () (element 'div #:attrs '((id "a") (id "b")))))
  (check-equal? (car (page-layout #:title "Hello" (element 'p "World"))) 'html))
