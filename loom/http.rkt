#lang racket/base
(require racket/list racket/port racket/string json net/url web-server/http)
(provide json-response request-json query-values request-header-values redirect-local)
(define (json-response value #:code [code 200])
  (response/full code #f (current-seconds) #"application/json; charset=utf-8"
                 (list (header #"X-Content-Type-Options" #"nosniff"))
                 (list (jsexpr->bytes value))))
(define (request-header-values req name)
  (unless (bytes? name) (raise-argument-error 'request-header-values "bytes?" name))
  (for/list ([h (in-list (request-headers/raw req))]
             #:when (string-ci=? (bytes->string/latin-1 (header-field h))
                                 (bytes->string/latin-1 name)))
    (header-value h)))
(define (query-values req name)
  (for/list ([p (in-list (url-query (request-uri req)))] #:when (eq? (car p) name))
    (cdr p)))
(define (request-json req #:max-bytes [max-bytes (* 1024 1024)])
  (unless (exact-nonnegative-integer? max-bytes)
    (raise-argument-error 'request-json "exact-nonnegative-integer?" max-bytes))
  (define types (request-header-values req #"Content-Type"))
  (unless (and (= (length types) 1)
               (regexp-match? #px"(?i:^application/json[ ]*(;.*)?$)"
                              (bytes->string/latin-1 (car types))))
    (error 'request-json "expected application/json"))
  (define body (request-post-data/raw req))
  (unless (and body (<= (bytes-length body) max-bytes))
    (error 'request-json "missing or oversized JSON body"))
  (define in (open-input-bytes body))
  (define value (read-json in))
  (when (eof-object? value) (error 'request-json "missing JSON value"))
  (unless (regexp-match? #rx#"^[ \t\r\n]*$" (port->bytes in))
    (error 'request-json "trailing data"))
  value)
(define (redirect-local location #:code [code 303])
  (unless (and (string? location) (string-prefix? location "/")
               (not (string-prefix? location "//"))
               (not (string-contains? location "\\"))
               (for/and ([c (in-string location)]) (and (> (char->integer c) 32) (< (char->integer c) 127))))
    (error 'redirect-local "expected a local ASCII URL path"))
  (unless (memv code '(301 302 303 307 308)) (error 'redirect-local "invalid redirect status"))
  (response/full code #f (current-seconds) #"text/plain; charset=utf-8"
                 (list (header #"Location" (string->bytes/utf-8 location))) '()))
(module+ test
  (require rackunit)
  (check-equal? (response-code (json-response (hasheq 'ok #t))) 200)
  (check-equal? (response-code (redirect-local "/account")) 303)
  (for ([url '("//evil.example" "https://evil.example" "/\\evil.example" "/a\r\nX:1")])
    (check-exn exn:fail? (lambda () (redirect-local url))))
  (check-exn exn:fail? (lambda () (redirect-local "/" #:code 200))))
