#lang racket/base
(require net/uri-codec racket/string web-server/http "http.rkt")
(provide request-form form-values)
;; Limit applies to bytes already buffered by the HTTP server.
(define (request-form req #:max-bytes [limit 65536])
  (unless (exact-nonnegative-integer? limit)
    (raise-argument-error 'request-form "exact-nonnegative-integer?" limit))
  (define types (request-header-values req #"Content-Type"))
  (unless (and (= (length types) 1)
               (regexp-match? #px"(?i:^application/x-www-form-urlencoded[ ]*(;.*)?$)"
                              (bytes->string/latin-1 (car types))))
    (error 'request-form "expected URL-encoded form"))
  (define body (request-post-data/raw req))
  (unless (and body (<= (bytes-length body) limit))
    (error 'request-form "missing or oversized form body"))
  (decode-form (bytes->string/utf-8 body)))
(define (decode-form text)
  (if (string=? text "") '()
      (for/list ([part (in-list (string-split text "&" #:trim? #f #:repeat? #f))])
        (define match (regexp-match #rx"^([^=]*)(=(.*))?$" part))
        (define (decode value)
          (when (regexp-match? #px"%(?![0-9a-fA-F]{2})" value)
            (error 'request-form "invalid percent escape"))
          (form-urlencoded-decode value))
        (cons (decode (cadr match)) (decode (or (cadddr match) ""))))))
(define (form-values form name)
  (for/list ([entry (in-list form)] #:when (string=? (car entry) name))
    (cdr entry)))
(module+ test
  (require rackunit)
  (check-equal? (decode-form "a=1&a=2&name=hello+world&empty=")
                '(("a" . "1") ("a" . "2") ("name" . "hello world") ("empty" . "")))
  (check-equal? (form-values (decode-form "a=1&a=2") "a") '("1" "2"))
  (check-equal? (decode-form "a=x%26y%3Dz") '(("a" . "x&y=z")))
  (check-equal? (decode-form "") '())
  (check-exn exn:fail? (lambda () (decode-form "a=%GG"))))
