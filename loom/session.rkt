#lang racket/base
(require racket/random)
(provide make-session-store session-create! session-ref session-delete! session-rotate!)
(struct entry (value expiry) #:transparent)
(struct store (table lock ttl capacity clock) #:transparent)
(define (make-session-store #:ttl [ttl 3600] #:capacity [capacity 10000]
                            #:clock [clock current-seconds])
  (unless (and (exact-positive-integer? ttl) (exact-positive-integer? capacity))
    (error 'make-session-store "positive ttl and capacity required"))
  (store (make-hash) (make-semaphore 1) ttl capacity clock))
(define digits "0123456789abcdef")
(define (token)
  (list->string
   (for*/list ([b (in-bytes (crypto-random-bytes 32))]
               [n (in-list (list (quotient b 16) (remainder b 16)))])
     (string-ref digits n))))
(define (locked s f) (call-with-semaphore (store-lock s) f))
(define (prune! s now)
  (for ([k (in-list (hash-keys (store-table s)))])
    (when (<= (entry-expiry (hash-ref (store-table s) k)) now)
      (hash-remove! (store-table s) k))))
(define (insert! s value now)
  (when (>= (hash-count (store-table s)) (store-capacity s))
    (error 'session-create! "session capacity reached"))
  (let loop ()
    (define id (token))
    (if (hash-has-key? (store-table s) id) (loop)
        (begin (hash-set! (store-table s) id (entry value (+ now (store-ttl s)))) id))))
(define (session-create! s value)
  (when (eq? value #f) (error 'session-create! "#f reserved for absent session"))
  (locked s (lambda () (define now ((store-clock s))) (prune! s now) (insert! s value now))))
(define (session-ref s id)
  (locked s (lambda ()
    (define e (hash-ref (store-table s) id #f))
    (cond [(not e) #f]
          [(<= (entry-expiry e) ((store-clock s))) (hash-remove! (store-table s) id) #f]
          [else (entry-value e)]))))
(define (session-delete! s id)
  (locked s (lambda () (hash-remove! (store-table s) id) (void))))
(define (session-rotate! s id)
  (locked s (lambda ()
    (define now ((store-clock s)))
    (prune! s now)
    (define e (hash-ref (store-table s) id #f))
    (and e (let ([value (entry-value e)])
             (hash-remove! (store-table s) id)
             (insert! s value now))))))
(module+ test
  (require rackunit)
  (define now 100)
  (define s (make-session-store #:ttl 10 #:capacity 1 #:clock (lambda () now)))
  (define id (session-create! s 'user))
  (check-equal? (string-length id) 64)
  (check-equal? (session-ref s id) 'user)
  (check-exn exn:fail? (lambda () (session-create! s 'other)))
  (define next (session-rotate! s id))
  (check-not-equal? next id)
  (check-false (session-ref s id))
  (check-equal? (session-ref s next) 'user)
  (set! now 110)
  (check-false (session-ref s next))
  (define third (session-create! s 'other))
  (session-delete! s third)
  (check-false (session-ref s third))
  (check-false (session-rotate! s third)))
