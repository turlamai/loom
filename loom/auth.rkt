#lang racket/base
(require web-server/http "http.rkt" "session-http.rkt")
(provide make-principal principal? principal-id principal-roles principal-has-role?
         current-principal authentication-middleware require-authentication require-role)
(struct principal (id roles) #:transparent)
(define (make-principal id #:roles [roles '()])
  (unless (and (string? id) (<= 1 (string-length id) 256)
               (list? roles) (andmap symbol? roles))
    (error 'make-principal "invalid identity or roles"))
  (principal (string->immutable-string id) (remove-duplicates/local roles)))
(define (remove-duplicates/local xs)
  (reverse (for/fold ([out '()]) ([x (in-list xs)])
             (if (memq x out) out (cons x out)))))
(define (principal-has-role? p role)
  (and (principal? p) (symbol? role) (if (memq role (principal-roles p)) #t #f)))
(define current-principal (make-parameter #f))
;; resolve is trusted application code: session data -> current principal or #f.
;; Resolve on every request so disabled accounts and changed roles take effect.
(define (authentication-middleware store resolve #:secure? [secure? #t])
  (lambda (next)
    (lambda (req)
      (define state (web-session-ref store req #:secure? secure?))
      (define identity (and state (resolve (web-session-data state))))
      (unless (or (not identity) (principal? identity))
        (error 'authentication-middleware "resolver must return principal or #f"))
      (parameterize ([current-principal identity]) (next req)))))
(define (deny code)
  (define resp (json-response (hasheq 'error (if (= code 401) "authentication-required" "forbidden")) #:code code))
  (struct-copy response resp
    [headers (cons (header #"Cache-Control" #"no-store") (response-headers resp))]))
(define (require-authentication next)
  (lambda (req)
    (if (principal? (current-principal)) (next req) (deny 401))))
(define (require-role role next)
  (unless (symbol? role) (raise-argument-error 'require-role "symbol?" role))
  (lambda (req)
    (define p (current-principal))
    (cond [(not (principal? p)) (deny 401)]
          [(not (principal-has-role? p role)) (deny 403)]
          [else (next req)])))
(module+ test
  (require rackunit net/url racket/promise "session.rkt")
  (define store (make-session-store))
  (define-values (sid state cookie) (start-web-session store "alice"))
  (define enabled #t)
  (define roles '(reader))
  (define middleware (authentication-middleware store
    (lambda (id) (and enabled (make-principal id #:roles roles)))))
  (define protected (middleware (require-role 'admin (lambda (req)
    (json-response (hasheq 'id (principal-id (current-principal))))))))
  (define (req [id #f])
    (request #"GET" (string->url "/admin")
      (if id (list (header #"Cookie" (string->bytes/utf-8 (string-append "__Host-loom-session=" id)))) '())
      (delay '()) #f "localhost" 8080 "127.0.0.1"))
  (check-equal? (response-code (protected (req))) 401)
  (check-equal? (response-code (protected (req sid))) 403)
  (set! roles '(reader admin))
  (check-equal? (response-code (protected (req sid))) 200)
  (check-false (current-principal))
  (set! enabled #f)
  (check-equal? (response-code (protected (req sid))) 401)
  (check-equal? (response-code ((require-authentication (lambda (_) (json-response #t))) (req))) 401)
  (check-equal? (principal-roles (make-principal "alice" #:roles '(admin admin))) '(admin))
  (check-exn exn:fail? (lambda () (make-principal ""))))
