#lang racket/base
(require db racket/list racket/string "model.rkt")
(provide make-repository repository-insert! repository-get repository-update! repository-delete! repository-list repository-find repository-count
         make-association repository-parent repository-children repository-child-count)
(struct repository (schema table key names) #:transparent)
(define (identifier name)
  (unless (and (symbol? name) (regexp-match? #rx"^[a-z_][a-z0-9_]*$" (symbol->string name)))
    (error 'repository "expected lowercase SQL identifier"))
  (format "\"~a\"" name))
(define (make-repository schema #:table [table (model-name schema)] #:key key)
  (identifier table)
  (define names (map field-name (model-fields schema)))
  (for-each identifier names)
  (define primary (findf (lambda (f) (eq? (field-name f) key)) (model-fields schema)))
  (unless (and primary (field-required? primary) (memq (field-type primary) '(integer string)))
    (error 'make-repository "key must be a required string or integer field"))
  (repository schema table key names))
(define (dialect conn)
  (define name (dbsystem-name (connection-dbsystem conn)))
  (unless (memq name '(sqlite3 postgresql))
    (error 'repository "unsupported database dialect"))
  name)
(define (placeholder engine index)
  (if (eq? engine 'postgresql) (format "$~a" index) "?"))
(define (columns names) (string-join (map identifier names) ", "))
(define (table-name r) (identifier (repository-table r)))
(define (key-name r) (identifier (repository-key r)))
(define (encode engine v)
  (if (and (eq? engine 'sqlite3) (boolean? v)) (if v 1 0) v))
(define (decode engine r row)
  (and row
       (for/hasheq ([f (in-list (model-fields (repository-schema r)))]
                    [v (in-vector row)] #:unless (sql-null? v))
         (values (field-name f)
                 (if (eq? (field-type f) 'boolean)
                     (if (eq? engine 'postgresql)
                         (if (boolean? v) v (error 'repository "invalid stored boolean"))
                         (case v [(0) #f] [(1) #t] [else (error 'repository "invalid stored boolean")]))
                     v)))))
(define (checked-values engine r data)
  (unless (null? (validate-model (repository-schema r) data))
    (error 'repository "model validation failed"))
  (for/list ([n (in-list (repository-names r))])
    (if (hash-has-key? data n) (encode engine (hash-ref data n)) sql-null)))
(define (repository-insert! conn r data)
  (define engine (dialect conn))
  (define vals (checked-values engine r data))
  (apply query-exec conn
         (format "INSERT INTO ~a (~a) VALUES (~a)" (table-name r)
                 (columns (repository-names r))
                 (string-join (for/list ([i (in-range 1 (add1 (length vals)))]) (placeholder engine i)) ", "))
         vals))
(define (repository-get conn r id)
  (define engine (dialect conn))
  (decode engine r (query-maybe-row conn
             (format "SELECT ~a FROM ~a WHERE ~a = ~a" (columns (repository-names r)) (table-name r) (key-name r) (placeholder engine 1)) id)))
(define (repository-update! conn r data)
  (define engine (dialect conn))
  (checked-values engine r data)
  (define names (remove (repository-key r) (repository-names r)))
  (unless (pair? names) (error 'repository-update! "no writable fields"))
  (define vals (for/list ([n (in-list names)])
                 (if (hash-has-key? data n) (encode engine (hash-ref data n)) sql-null)))
  (apply query-exec conn
         (format "UPDATE ~a SET ~a WHERE ~a = ~a" (table-name r)
                 (string-join (for/list ([n (in-list names)] [i (in-naturals 1)])
                                (format "~a = ~a" (identifier n) (placeholder engine i))) ", ")
                 (key-name r) (placeholder engine (add1 (length names))))
         (append vals (list (hash-ref data (repository-key r))))))
(define (repository-delete! conn r id)
  (define engine (dialect conn))
  (query-exec conn (format "DELETE FROM ~a WHERE ~a = ~a" (table-name r) (key-name r) (placeholder engine 1)) id))
(define (repository-list conn r #:limit [limit 100] #:offset [offset 0])
  (define engine (dialect conn))
  (unless (and (exact-positive-integer? limit) (<= limit 1000) (exact-nonnegative-integer? offset))
    (error 'repository-list "invalid pagination"))
  (map (lambda (row) (decode engine r row))
       (query-rows conn (format "SELECT ~a FROM ~a ORDER BY ~a LIMIT ~a OFFSET ~a"
                               (columns (repository-names r)) (table-name r) (key-name r)
                               (placeholder engine 1) (placeholder engine 2))
                   limit offset)))
;; Equality filters are schema-checked and values are always bound.
;; SQL NULL is explicit via sql-null, not the boolean #f.
(define (filter-clause engine r filters)
  (unless (hash? filters) (raise-argument-error 'repository-query "hash?" filters))
  (for ([name (in-hash-keys filters)])
    (unless (memq name (repository-names r)) (error 'repository-query "unknown filter field")))
  (define parts '())
  (define args '())
  (for ([f (in-list (model-fields (repository-schema r)))]
        #:when (hash-has-key? filters (field-name f)))
    (define n (field-name f))
    (define v (hash-ref filters n))
    (cond [(sql-null? v)
           (when (field-required? f) (error 'repository-query "required field cannot be null"))
           (set! parts (cons (format "~a IS NULL" (identifier n)) parts))]
          [else
           (unless (null? (validate-model (make-model 'filter (list f)) (hasheq n v)))
             (error 'repository-query "invalid filter value"))
           (set! args (cons (encode engine v) args))
           (set! parts (cons (format "~a = ~a" (identifier n) (placeholder engine (length args))) parts))]))
  (values (if (null? parts) "" (string-append " WHERE " (string-join (reverse parts) " AND ")))
          (reverse args)))
(define (repository-find conn r #:where [filters (hasheq)] #:order-by [order (repository-key r)]
                         #:descending? [descending? #f] #:limit [limit 100] #:offset [offset 0])
  (define engine (dialect conn))
  (unless (and (memq order (repository-names r)) (boolean? descending?)
               (exact-positive-integer? limit) (<= limit 1000)
               (exact-nonnegative-integer? offset))
    (error 'repository-find "invalid ordering or pagination"))
  (define-values (where args) (filter-clause engine r filters))
  (define direction (if descending? "DESC" "ASC"))
  (define ordering (string-append (identifier order) " " direction
    (if (eq? order (repository-key r)) "" (string-append ", " (key-name r) " ASC"))))
  (map (lambda (row) (decode engine r row))
       (apply query-rows conn
         (format "SELECT ~a FROM ~a~a ORDER BY ~a LIMIT ~a OFFSET ~a"
                 (columns (repository-names r)) (table-name r) where ordering
                 (placeholder engine (add1 (length args))) (placeholder engine (+ 2 (length args))))
         (append args (list limit offset)))))
(define (repository-count conn r #:where [filters (hasheq)])
  (define engine (dialect conn))
  (define-values (where args) (filter-clause engine r filters))
  (apply query-value conn (format "SELECT count(*) FROM ~a~a" (table-name r) where) args))
;; Explicit associations: the foreign-key field must match the target key type.
(struct association (child parent foreign-key) #:transparent)
(define (lookup-field r name)
  (findf (lambda (f) (eq? name (field-name f))) (model-fields (repository-schema r))))
(define (make-association child parent #:foreign-key foreign-key)
  (unless (and (repository? child) (repository? parent))
    (error 'make-association "expected repositories"))
  (define f (lookup-field child foreign-key))
  (define p (lookup-field parent (repository-key parent)))
  (unless (and f (eq? (field-type f) (field-type p)))
    (error 'make-association "foreign key must match parent key type"))
  (association child parent foreign-key))
(define (repository-parent conn a child-row)
  (define child (association-child a))
  (unless (and (hash? child-row) (null? (validate-model (repository-schema child) child-row)))
    (error 'repository-parent "invalid child row"))
  (define fk (association-foreign-key a))
  (and (hash-has-key? child-row fk)
       (repository-get conn (association-parent a) (hash-ref child-row fk))))
(define (parent-key a row)
  (unless (and (hash? row) (null? (validate-model (repository-schema (association-parent a)) row)))
    (error 'repository-children "invalid parent row"))
  (hash-ref row (repository-key (association-parent a))))
(define (repository-children conn a parent-row #:limit [limit 100] #:offset [offset 0]
                             #:where [filters (hasheq)])
  (define fk (association-foreign-key a))
  (unless (and (hash? filters) (not (hash-has-key? filters fk)))
    (error 'repository-children "foreign-key filter is controlled by the association"))
  (repository-find conn (association-child a)
    #:where (hash-set (for/hasheq ([(k v) (in-hash filters)]) (values k v)) fk (parent-key a parent-row))
    #:limit limit #:offset offset))
(define (repository-child-count conn a parent-row)
  (repository-count conn (association-child a)
    #:where (hasheq (association-foreign-key a) (parent-key a parent-row))))
(module+ test
  (require rackunit "db.rkt")
  (define-model task [id integer #t] [title string #t] [done boolean #t] [note string #f])
  (define r (make-repository task #:table 'tasks #:key 'id))
  (define-model project [id integer #t] [name string #t])
  (define-model entry [id integer #t] [project_id integer #f] [done boolean #t])
  (define projects (make-repository project #:table 'projects #:key 'id))
  (define entries (make-repository entry #:table 'entries #:key 'id))
  (define assoc (make-association entries projects #:foreign-key 'project_id))
  (with-db (lambda () (open-sqlite 'memory))
    (lambda (c)
      (query-exec c "CREATE TABLE projects (id INTEGER PRIMARY KEY, name TEXT NOT NULL)")
      (query-exec c "CREATE TABLE entries (id INTEGER PRIMARY KEY, project_id INTEGER, done INTEGER NOT NULL)")
      (define p (hasheq 'id 1 'name "one"))
      (define q (hasheq 'id 2 'name "two"))
      (define a (hasheq 'id 10 'project_id 1 'done #f))
      (define b (hasheq 'id 11 'project_id 1 'done #t))
      (define d (hasheq 'id 12 'project_id 2 'done #f))
      (define orphan (hasheq 'id 13 'done #f))
      (for ([v (in-list (list p q))]) (repository-insert! c projects v))
      (for ([v (in-list (list a b d orphan))]) (repository-insert! c entries v))
      (check-equal? (repository-parent c assoc a) p)
      (check-false (repository-parent c assoc orphan))
      (check-equal? (repository-children c assoc p) (list a b))
      (check-equal? (repository-children c assoc p #:where (hasheq 'done #f)) (list a))
      (check-equal? (repository-children c assoc p #:limit 1 #:offset 1) (list b))
      (check-equal? (repository-child-count c assoc p) 2)
      (check-equal? (repository-children c assoc q) (list d))
      (check-exn exn:fail? (lambda () (repository-children c assoc p #:where (hasheq 'project_id 2))))
      (check-exn exn:fail? (lambda () (make-association entries projects #:foreign-key 'done)))))
  (with-db (lambda () (open-sqlite 'memory))
    (lambda (c)
      (query-exec c "CREATE TABLE tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, done INTEGER NOT NULL, note TEXT)")
      (define item (hasheq 'id 1 'title "x'); DROP TABLE tasks; --" 'done #f))
      (repository-insert! c r item)
      (check-equal? (repository-get c r 1) item)
      (check-exn exn:fail? (lambda () (repository-insert! c r (hasheq 'id 2))))
      (repository-update! c r (hash-set item 'done #t))
      (check-equal? (repository-list c r #:limit 1) (list (hash-set item 'done #t)))
      (check-equal? (repository-list c r #:offset 1) '())
      (repository-insert! c r (hasheq 'id 2 'title "second" 'done #f 'note "note"))
      (repository-insert! c r (hasheq 'id 3 'title "second" 'done #f))
      (check-equal? (map (lambda (v) (hash-ref v 'id)) (repository-find c r #:where (hasheq 'done #f) #:order-by 'title #:descending? #t)) '(2 3))
      (check-equal? (repository-count c r #:where (hasheq 'note sql-null)) 2)
      (check-equal? (repository-find c r #:where (hasheq 'title (hash-ref item 'title))) (list (hash-set item 'done #t)))
      (check-equal? (repository-count c r #:where (hasheq 'done #f 'title "second")) 2)
      (check-equal? (map (lambda (v) (hash-ref v 'id)) (repository-find c r #:limit 1 #:offset 1)) '(2))
      (check-exn exn:fail? (lambda () (repository-find c r #:where (hasheq 'done "false"))))
      (check-exn exn:fail? (lambda () (repository-count c r #:where (hasheq 'unknown 1))))
      (check-exn exn:fail? (lambda () (repository-find c r #:order-by '|id;drop|)))
      (repository-delete! c r 1)
      (check-false (repository-get c r 1))))
  (check-exn exn:fail? (lambda () (make-repository task #:table '|bad;name| #:key 'id))))
