#lang racket/base
(require web-server/http racket/string "http.rkt" "session.rkt" "cookies.rkt" "csrf.rkt")
(provide start-web-session web-session-ref end-web-session
         web-session? web-session-data web-session-csrf web-session-valid-csrf?)
(struct web-session (data csrf) #:transparent)
(define (start-web-session store data #:secure? [secure? #t])
  (define name (if secure? "__Host-loom-session" "loom-dev-session"))
  (define state (web-session data (csrf-token)))
  (define id (session-create! store state))
  (values id state (set-cookie-header name id #:secure? secure?)))
;; Count every named candidate, including malformed values; reject ambiguity.
(define (session-id req name)
  (define candidates
    (for*/list ([raw (in-list (request-header-values req #"Cookie"))]
                [part (in-list (string-split (bytes->string/latin-1 raw) ";"))]
                #:do [(define p (string-split (string-trim part) "=" #:trim? #f #:repeat? #f))]
                #:when (and (pair? p) (string=? (string-trim (car p)) name)))
      (and (= (length p) 2) (cadr p))))
  (and (= (length candidates) 1)
       (let ([id (car candidates)])
         (and (string? id) (= (string-length id) 64)
              (regexp-match? #rx"^[0-9a-f]+$" id) id))))
(define (web-session-ref store req #:secure? [secure? #t])
  (define id (session-id req (if secure? "__Host-loom-session" "loom-dev-session")))
  (define state (and id (session-ref store id)))
  (and (web-session? state) state))
(define (end-web-session store req #:secure? [secure? #t])
  (define name (if secure? "__Host-loom-session" "loom-dev-session"))
  (define id (session-id req name))
  (when id (session-delete! store id))
  (clear-cookie-header name #:secure? secure?))
(define (web-session-valid-csrf? state submitted-values)
  (and (web-session? state) (list? submitted-values)
       (= (length submitted-values) 1)
       (csrf-valid? (web-session-csrf state) (car submitted-values))))
(module+ test
  (require rackunit net/url racket/promise)
  (define store (make-session-store))
  (define-values (id state cookie) (start-web-session store 'alice))
  (define (req value)
    (request #"POST" (string->url "/") (list (header #"Cookie" (string->bytes/utf-8 value)))
             (delay '()) #f "localhost" 8080 "127.0.0.1"))
  (define valid (req (string-append "__Host-loom-session=" id)))
  (check-equal? (web-session-data (web-session-ref store valid)) 'alice)
  (check-true (web-session-valid-csrf? state (list (web-session-csrf state))))
  (check-false (web-session-valid-csrf? state (list (web-session-csrf state) "duplicate")))
  (check-false (web-session-valid-csrf? state (list (csrf-token))))
  (check-false (web-session-ref store (req (string-append "__Host-loom-session=" id "; __Host-loom-session=invalid"))))
  (check-true (header? (end-web-session store valid)))
  (check-false (web-session-ref store valid)))
