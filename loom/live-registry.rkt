#lang racket/base
(require "live.rkt" "csrf.rkt")
(provide make-live-registry registry-mount! registry-snapshot registry-dispatch!
         registry-unmount! registry-revoke-owner! registry-prune!)
(struct slot (owner instance expiry) #:transparent)
(struct registry (entries lock ttl capacity per-owner clock) #:transparent)
;; Owner is a trusted server-side session identifier, never a client assertion.
;; Registry callbacks run under the registry lock and must not reenter it.
(define (make-live-registry #:ttl [ttl 1800] #:capacity [capacity 1024]
                            #:per-owner [per-owner 16] #:clock [clock current-seconds])
  (unless (and (exact-positive-integer? ttl) (exact-positive-integer? capacity)
               (exact-positive-integer? per-owner))
    (error 'make-live-registry "positive limits required"))
  (registry (make-hash) (make-semaphore 1) ttl capacity per-owner clock))
(define (locked r proc) (call-with-semaphore (registry-lock r) proc))
(define (prune/locked! r now)
  (for ([id (in-list (hash-keys (registry-entries r)))])
    (when (<= (slot-expiry (hash-ref (registry-entries r) id)) now)
      (hash-remove! (registry-entries r) id))))
(define (registry-prune! r)
  (locked r (lambda () (prune/locked! r ((registry-clock r))))))
(define (registry-mount! r owner component)
  (unless (and (string? owner) (positive? (string-length owner)))
    (error 'registry-mount! "trusted owner required"))
  (locked r
    (lambda ()
      (define now ((registry-clock r)))
      (prune/locked! r now)
      (define entries (registry-entries r))
      (when (or (>= (hash-count entries) (registry-capacity r))
                (>= (for/sum ([s (in-hash-values entries)] #:when (equal? owner (slot-owner s))) 1)
                    (registry-per-owner r)))
        (error 'registry-mount! "live instance capacity reached"))
      (define instance (live-mount component))
      (define id (let loop () (define candidate (csrf-token))
                   (if (hash-has-key? entries candidate) (loop) candidate)))
      (hash-set! entries id (slot (string->immutable-string owner) instance (+ now (registry-ttl r))))
      id)))
(define (with-slot r owner id proc)
  (locked r
    (lambda ()
      (define entries (registry-entries r))
      (define s (hash-ref entries id #f))
      (cond [(not s) #f]
            [(<= (slot-expiry s) ((registry-clock r))) (hash-remove! entries id) #f]
            [(not (equal? owner (slot-owner s))) #f]
            [else (proc s)]))))
(define (registry-snapshot r owner id)
  (with-slot r owner id (lambda (s) (live-snapshot (slot-instance s)))))
(define (registry-dispatch! r owner id version event payload)
  (with-slot r owner id (lambda (s) (live-dispatch! (slot-instance s) version event payload))))
(define (registry-unmount! r owner id)
  (with-slot r owner id (lambda (s) (hash-remove! (registry-entries r) id) #t)))
(define (registry-revoke-owner! r owner)
  (locked r (lambda ()
    (for ([id (in-list (hash-keys (registry-entries r)))])
      (when (equal? owner (slot-owner (hash-ref (registry-entries r) id)))
        (hash-remove! (registry-entries r) id))))))
(module+ test
  (require rackunit "html.rkt")
  (define now 100)
  (define r (make-live-registry #:ttl 10 #:capacity 2 #:per-owner 1 #:clock (lambda () now)))
  (define component (make-live-component #:initial (lambda () 0)
    #:render (lambda (n) (element 'p n))
    #:events (hash "inc" (lambda (n p) (add1 n)))))
  (define a (registry-mount! r "alice" component))
  (define b (registry-mount! r "bob" component))
  (check-false (registry-snapshot r "bob" a))
  (check-false (registry-dispatch! r "bob" a 0 "inc" #f))
  (check-false (registry-unmount! r "bob" a))
  (check-exn exn:fail? (lambda () (registry-mount! r "carol" component)))
  (check-equal? (live-result-version (registry-dispatch! r "alice" a 0 "inc" #f)) 1)
  (check-equal? (live-result-version (registry-snapshot r "bob" b)) 0)
  (registry-revoke-owner! r "alice")
  (check-false (registry-snapshot r "alice" a))
  (check-exn exn:fail? (lambda () (registry-mount! r "bob" component)))
  (set! now 110)
  (registry-prune! r)
  (check-false (registry-snapshot r "bob" b))
  (define c (registry-mount! r "bob" component))
  (check-true (registry-unmount! r "bob" c))
  (check-false (registry-snapshot r "bob" c)))
