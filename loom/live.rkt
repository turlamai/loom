#lang racket/base
(require racket/list "html.rkt")
(provide make-live-component live-component? live-mount live-instance?
         live-snapshot live-dispatch! live-result? live-result-status
         live-result-version live-result-view)
(struct live-component (initial render handlers) #:transparent)
(struct live-instance (component state version lock) #:mutable)
(struct live-result (status version view) #:transparent)
;; State is application-owned immutable data. Renderers and reducers must be
;; pure, bounded and must not reenter the instance while its lock is held.
(define (make-live-component #:initial initial #:render render #:events events)
  (unless (and (procedure? initial) (procedure-arity-includes? initial 0)
               (procedure? render) (procedure-arity-includes? render 1)
               (hash? events)
               (for/and ([(name handler) (in-hash events)])
                 (and (string? name) (regexp-match? #rx"^[a-z][a-z0-9_-]*$" name)
                      (procedure? handler) (procedure-arity-includes? handler 2))))
    (error 'make-live-component "invalid component contract"))
  (live-component initial render (make-immutable-hash (hash->list events))))
(define (render-state component state)
  ;; Revalidate renderer output through the constrained HTML builder.
  (element 'div ((live-component-render component) state)))
(define (live-mount component)
  (define state ((live-component-initial component)))
  (render-state component state)
  (live-instance component state 0 (make-semaphore 1)))
(define (snapshot/locked instance status)
  (live-result status (live-instance-version instance)
               (render-state (live-instance-component instance) (live-instance-state instance))))
(define (live-snapshot instance)
  (call-with-semaphore (live-instance-lock instance)
    (lambda () (snapshot/locked instance 'ok))))
(define (live-dispatch! instance expected-version event payload)
  (unless (exact-nonnegative-integer? expected-version)
    (raise-argument-error 'live-dispatch! "exact-nonnegative-integer?" expected-version))
  (call-with-semaphore (live-instance-lock instance)
    (lambda ()
      (define component (live-instance-component instance))
      (define handler (and (string? event) (hash-ref (live-component-handlers component) event #f)))
      (cond
        [(not (= expected-version (live-instance-version instance)))
         (snapshot/locked instance 'stale)]
        [(not handler) (snapshot/locked instance 'unknown-event)]
        [else
         (define state (handler (live-instance-state instance) payload))
         (define view (render-state component state))
         (define version (add1 (live-instance-version instance)))
         ;; Commit only after rendering succeeds.
         (set-live-instance-state! instance state)
         (set-live-instance-version! instance version)
         (live-result 'ok version view)]))))
(module+ test
  (require rackunit)
  (define component
    (make-live-component #:initial (lambda () 0)
                         #:render (lambda (n) (element 'p n))
                         #:events (hash "inc" (lambda (n payload) (add1 n))
                                        "fail" (lambda (n payload) (error 'test "abort")))))
  (define a (live-mount component))
  (define b (live-mount component))
  (check-equal? (live-result-view (live-snapshot a)) '(div () (p () "0")))
  (define updated (live-dispatch! a 0 "inc" #f))
  (check-equal? (live-result-version updated) 1)
  (check-equal? (live-result-view updated) '(div () (p () "1")))
  (check-equal? (live-result-status (live-dispatch! a 0 "inc" #f)) 'stale)
  (check-equal? (live-result-status (live-dispatch! a 1 "missing" #f)) 'unknown-event)
  (check-exn exn:fail? (lambda () (live-dispatch! a 1 "fail" #f)))
  (check-equal? (live-result-version (live-snapshot a)) 1)
  (check-equal? (live-result-version (live-snapshot b)) 0)
  (define unsafe
    (live-mount (make-live-component #:initial (lambda () #f)
                  #:render (lambda (s) (if s '(script () "bad") (element 'p "safe")))
                  #:events (hash "change" (lambda (s p) #t)))))
  (check-exn exn:fail? (lambda () (live-dispatch! unsafe 0 "change" #f)))
  (check-equal? (live-result-version (live-snapshot unsafe)) 0)
  (define c (live-mount component))
  (define ch (make-channel))
  (for ([i (in-range 2)])
    (thread (lambda () (channel-put ch (live-result-status (live-dispatch! c 0 "inc" #f))))))
  (check-equal? (sort (list (channel-get ch) (channel-get ch)) symbol<?) '(ok stale))
  (check-equal? (live-result-version (live-snapshot c)) 1))
