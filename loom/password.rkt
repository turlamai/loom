#lang racket/base
(require crypto crypto/argon2)
(provide make-password-service password-hash password-verify password-needs-rehash?)
(struct service (kdf slots))
(define (make-password-service #:concurrency [concurrency 2])
  (unless (and (exact-integer? concurrency) (<= 1 concurrency 16))
    (error 'make-password-service "invalid concurrency"))
  (define kdf (get-kdf 'argon2id argon2-factory))
  (unless kdf (error 'make-password-service "Argon2id provider unavailable"))
  (service kdf (make-semaphore concurrency)))
(define params '((m 19456) (t 2) (p 1)))
(define (valid-password? p)
  (and (bytes? p) (<= 1 (bytes-length p) 1024)))
;; Only accept bounded, canonical v19 PHC credentials with 16-byte salt
;; and 32-byte tag. Never pass unbounded work factors to the provider.
(define (credential-cost encoded)
  (and (string? encoded) (<= (string-length encoded) 160)
       (let ([m (regexp-match #px"^\\$argon2id\\$v=19\\$m=([1-9][0-9]{0,5}),t=([1-9][0-9]?),p=([1-9][0-9]?)\\$[A-Za-z0-9+/]{22}\\$[A-Za-z0-9+/]{43}$" encoded)])
         (and m
              (let ([memory (string->number (list-ref m 1))]
                    [time (string->number (list-ref m 2))]
                    [lanes (string->number (list-ref m 3))])
                (and (<= (* 8 lanes) memory 65536) (<= 1 time 4)
                     (<= 1 lanes 4) (list memory time lanes)))))))
(define (password-hash s password)
  (unless (valid-password? password) (error 'password-hash "invalid password length"))
  (call-with-semaphore (service-slots s)
    (lambda () (pwhash (service-kdf s) password params))))
(define (password-verify s password encoded)
  (and (valid-password? password) (credential-cost encoded)
       (call-with-semaphore (service-slots s)
         (lambda ()
           (with-handlers ([exn:fail? (lambda (_) #f)])
             (pwhash-verify (service-kdf s) password encoded))))))
;; Flag weaker memory/time factors, not stronger ones. Verify before upgrading.
(define (password-needs-rehash? encoded)
  (define cost (credential-cost encoded))
  (and cost (or (< (car cost) 19456) (< (cadr cost) 2))))
(module+ test
  (require rackunit)
  (define s (make-password-service))
  (define secret #"example-password-only")
  (define a (password-hash s secret))
  (define b (password-hash s secret))
  (check-not-equal? a b)
  (check-true (password-verify s secret a))
  (check-false (password-verify s #"wrong" a))
  (check-false (password-verify s secret "invalid"))
  (check-false (password-verify s secret (regexp-replace #rx"m=19456" a "m=999999")))
  (check-false (password-verify s (make-bytes 1025) a))
  (check-false (password-needs-rehash? a))
  (check-true (password-needs-rehash? (regexp-replace #rx"m=19456" a "m=4096")))
  (check-exn exn:fail? (lambda () (password-hash s #"")))
  (check-exn exn:fail? (lambda () (make-password-service #:concurrency 0))))
