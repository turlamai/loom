#lang racket/base
(require rackunit loom/db loom/model loom/repository loom/migrate)
(module+ test
  (define-model task [id integer #t] [title string #t] [done boolean #t] [note string #f])
  (define r (make-repository task #:table 'tasks #:key 'id))
  (with-db (lambda () (open-postgres #:database "loom_test" #:user "loom" #:password "loom-test-only" #:server "127.0.0.1" #:ssl 'no))
    (lambda (c)
      (define plan (list (migration 1 "tasks" (lambda (tx)
        (query-exec tx "CREATE TABLE tasks (id BIGINT PRIMARY KEY, title TEXT NOT NULL, done BOOLEAN NOT NULL, note TEXT)")))))
      (check-equal? (migrate! c plan) '(1))
      (check-equal? (migrate! c plan) '())
      (define item (hasheq 'id 1 'title "x'); DROP TABLE tasks; --" 'done #f))
      (repository-insert! c r item)
      (check-equal? (repository-get c r 1) item)
      (define updated (hash-set (hash-set item 'done #t) 'note "hello"))
      (repository-update! c r updated)
      (check-equal? (repository-list c r #:limit 1) (list updated))
      (check-equal? (repository-list c r #:offset 1) '())
      (repository-update! c r item)
      (check-equal? (repository-get c r 1) item)
      (check-exn exn:fail? (lambda ()
        (with-transaction c (lambda (tx)
          (repository-insert! tx r (hash-set item 'id 2))
          (error 'test "rollback")))))
      (check-false (repository-get c r 2))
      (check-exn exn:fail? (lambda () (migrate! c (append plan (list
        (migration 2 "failure" (lambda (tx)
          (query-exec tx "CREATE TABLE rollback_test (id INTEGER)")
          (error 'test "rollback"))))))))
      (check-equal? (length (applied-migrations c)) 1)
      (check-false (query-value c "SELECT to_regclass('rollback_test') IS NOT NULL"))
      (repository-delete! c r 1)
      (check-false (repository-get c r 1)))))
