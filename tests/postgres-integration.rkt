#lang racket/base
(require rackunit loom/db loom/model loom/repository loom/migrate loom/db-pool (only-in db start-transaction sql-null))
(module+ test
  (define-model task [id integer #t] [title string #t] [done boolean #t] [note string #f])
  (define r (make-repository task #:table 'tasks #:key 'id))
  (with-db (lambda () (open-postgres #:database "loom_test" #:user "loom" #:password "loom-test-only" #:server "127.0.0.1" #:ssl 'no))
    (lambda (c)
      (define plan (list (migration 1 "tasks" (lambda (tx)
        (query-exec tx "CREATE TABLE tasks (id BIGINT PRIMARY KEY, title TEXT NOT NULL, done BOOLEAN NOT NULL, note TEXT)")))))
      (check-equal? (migrate! c plan) '(1))
      (check-equal? (migrate! c plan) '())
      (define item (hasheq 'id 1 'title "x'); DROP TABLE tasks; --" 'done #f))
      (repository-insert! c r item)
      (check-equal? (repository-get c r 1) item)
      (define updated (hash-set (hash-set item 'done #t) 'note "hello"))
      (repository-update! c r updated)
      (check-equal? (repository-list c r #:limit 1) (list updated))
      (check-equal? (repository-list c r #:offset 1) '())
      (repository-update! c r item)
      (check-equal? (repository-get c r 1) item)
      (check-exn exn:fail? (lambda ()
        (with-transaction c (lambda (tx)
          (repository-insert! tx r (hash-set item 'id 2))
          (error 'test "rollback")))))
      (check-false (repository-get c r 2))
      (check-exn exn:fail? (lambda () (migrate! c (append plan (list
        (migration 2 "failure" (lambda (tx)
          (query-exec tx "CREATE TABLE rollback_test (id INTEGER)")
          (error 'test "rollback"))))))))
      (check-equal? (length (applied-migrations c)) 1)
      (check-false (query-value c "SELECT to_regclass('rollback_test') IS NOT NULL"))
      (repository-insert! c r (hasheq 'id 2 'title "second" 'done #f 'note "note"))
      (repository-insert! c r (hasheq 'id 3 'title "second" 'done #f))
      (check-equal? (repository-count c r #:where (hasheq 'done #f 'title "second")) 2)
      (check-equal? (repository-count c r #:where (hasheq 'note sql-null)) 2)
      (check-equal? (repository-find c r #:where (hasheq 'title (hash-ref item 'title))) (list item))
      (check-equal? (map (lambda (v) (hash-ref v 'id))
        (repository-find c r #:where (hasheq 'title "second") #:order-by 'title #:descending? #t #:limit 1 #:offset 1)) '(3))
      (check-exn exn:fail? (lambda () (repository-find c r #:where (hasheq 'done "false"))))
      (repository-delete! c r 2)
      (repository-delete! c r 3)
      (repository-delete! c r 1)
      (check-false (repository-get c r 1))))
  ;; Two independent connections contend on the same migration ledger.
  (define (connect) (open-postgres #:database "loom_test" #:user "loom" #:password "loom-test-only" #:server "127.0.0.1" #:ssl 'no))
  (define-model project [id integer #t] [name string #t])
  (define-model entry [id integer #t] [project_id integer #f] [done boolean #t])
  (define projects (make-repository project #:table 'projects #:key 'id))
  (define entries (make-repository entry #:table 'entries #:key 'id))
  (define assoc (make-association entries projects #:foreign-key 'project_id))
  (with-db connect
    (lambda (c)
      (query-exec c "CREATE TEMP TABLE projects (id BIGINT PRIMARY KEY, name TEXT NOT NULL)")
      (query-exec c "CREATE TEMP TABLE entries (id BIGINT PRIMARY KEY, project_id BIGINT REFERENCES projects(id), done BOOLEAN NOT NULL)")
      (define p (hasheq 'id 1 'name "one"))
      (define q (hasheq 'id 2 'name "two"))
      (define a (hasheq 'id 10 'project_id 1 'done #f))
      (define b (hasheq 'id 11 'project_id 1 'done #t))
      (define d (hasheq 'id 12 'project_id 2 'done #f))
      (define orphan (hasheq 'id 13 'done #f))
      (for ([v (in-list (list p q))]) (repository-insert! c projects v))
      (for ([v (in-list (list a b d orphan))]) (repository-insert! c entries v))
      (check-equal? (repository-parent c assoc a) p)
      (check-false (repository-parent c assoc orphan))
      (check-equal? (repository-children c assoc p) (list a b))
      (check-equal? (repository-children c assoc p #:where (hasheq 'done #f)) (list a))
      (check-equal? (repository-children c assoc p #:limit 1 #:offset 1) (list b))
      (check-equal? (repository-child-count c assoc p) 2)
      (check-equal? (repository-children c assoc q) (list d))
      (check-exn exn:fail? (lambda () (repository-children c assoc p #:where (hasheq 'project_id 2))))
      (check-exn exn:fail? (lambda () (repository-insert! c entries (hasheq 'id 14 'project_id 99 'done #f))))))
  (define entered (make-semaphore 0))
  (define release (make-semaphore 0))
  (define results (make-channel))
  (define concurrent-plan
    (list (migration 1 "tasks" void)
          (migration 2 "concurrent" (lambda (tx)
            (semaphore-post entered)
            (unless (sync/timeout 10 release) (error 'test "migration release timeout"))
            (query-exec tx "CREATE TABLE concurrent_migration (id INTEGER)")))))
  (define (worker)
    (thread (lambda ()
      (channel-put results
        (with-handlers ([exn:fail? values])
          (with-db connect (lambda (c) (migrate! c concurrent-plan))))))))
  (define first-worker (worker))
  (check-not-false (sync/timeout 10 entered))
  (define second-worker (worker))
  (check-false (sync/timeout 0.2 results))
  (semaphore-post release)
  (define a (sync/timeout 15 results))
  (define b (sync/timeout 15 results))
  (check-true (or (and (equal? a '(2)) (equal? b '()))
                  (and (equal? b '(2)) (equal? a '()))))
  (with-db connect (lambda (c)
    (check-equal? (length (applied-migrations c)) 2)))
  (define pool (make-db-pool
    (lambda () (open-postgres #:database "loom_test" #:user "loom" #:password "loom-test-only" #:server "127.0.0.1" #:ssl 'no))
    #:max-connections 1))
  (define pid (with-pooled-db pool (lambda (c) (query-value c "SELECT pg_backend_pid()"))))
  ;; Clean leases should reuse the backend. Dirty leases may be discarded.
  (check-equal? (with-pooled-db pool (lambda (c) (query-value c "SELECT pg_backend_pid()"))) pid)
  (check-exn exn:fail? (lambda ()
    (with-pooled-db pool (lambda (c)
      (start-transaction c)
      (repository-insert! c r (hasheq 'id 99 'title "uncommitted" 'done #f))
      (error 'test "release with open transaction")))))
  (with-pooled-db pool (lambda (c)
    (check-equal? (query-value c "SELECT 1") 1)
    (check-false (repository-get c r 99))
    (check-exn exn:fail? (lambda () (with-pooled-db pool void))))))
